DATABASE_URL=postgresql://postgres:change-me@your-postgres-host:5432/minuto
APP_ORIGIN=http://localhost:3000
PORT=3000
NODE_ENV=development
DEMO_MODE=false
# Optional PEM CA certificate for a PostgreSQL server that requires TLS.
# DATABASE_SSL_CA=
# Disable new account creation after registering the team's account.
ALLOW_REGISTRATION=true

# Correo de verificación y recuperación (solo variables de ejecución en Coolify).
# Verifica el dominio remitente en Resend antes del despliegue.
RESEND_API_KEY=
AUTH_EMAIL_FROM="BucaGest <acceso@tu-dominio.com>"

# Cada proveedor se muestra únicamente cuando su configuración está completa.
# Callback: APP_ORIGIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Callback HTTPS: APP_ORIGIN/api/auth/apple/callback
# APPLE_CLIENT_ID es el Services ID, no el App ID nativo.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Clave privada .p8 en formato PEM; se admiten saltos de línea o \n.
APPLE_PRIVATE_KEY=

# Callback: APP_ORIGIN/api/auth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Versión de Graph API de tu aplicación en Meta, con formato vNN.N.
FACEBOOK_API_VERSION=

# Obligatorios en producción. Consulta PRIVACY_SETUP.md antes de redesplegar.
# 64 caracteres hexadecimales aleatorios. Guarda copia segura y no cambies la clave
# de una base ya cifrada sin una migración planificada.
DATA_ENCRYPTION_KEY=
# Datos reales del prestador; se publican en /privacy. DSoft es la marca, no la identidad legal.
PRIVACY_OPERATOR=
PRIVACY_ADDRESS=
PRIVACY_EMAIL=
PRIVACY_HOSTING=
PRIVACY_PROVIDERS=
PRIVACY_TRANSFERS=
PRIVACY_RETENTION=
